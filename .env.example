# this will ignore local_settings.py
export IGNORE_LOCAL_SETTINGS=true

export SECRET_KEY=""  # place random string here, will not start otherwise!

# domains that will be used
export ALLOWED_HOSTS=inventar.zam.haus,i.zam.haus,id.zam.haus

# Main address (also in printed location labels); every other domain name redirects
# here, resolver hosts to LABEL_ID_RESOLVER_URL. Earlier addresses on old labels:
# (a bare domain means https://)
# export DEFAULT_URL=https://inventar.zam.haus  # formerly DEFAULT_DOMAIN, still read
# export DOMAIN_ALIASES=https://inv.zam.haus
# export CANONICAL_HOST_REDIRECT=true

# Login through OIDC (SSO): on by default when OIDC_RP_CLIENT_SECRET is set.
# Set OIDC_ENABLED=false to run without an SSO system (Django's own accounts).
# export OIDC_ENABLED=true

# Label ID resolver hosts (must also be in ALLOWED_HOSTS) and where they redirect to
# export LABEL_ID_RESOLVER_HOSTS=i.zam.haus,id.zam.haus
# export LABEL_ID_INVENTORY_BASE=https://inventar.zam.haus
# main resolver address; the other resolver hosts redirect there (label scans go straight on)
# export LABEL_ID_RESOLVER_URL=https://id.zam.haus/
# base URL in QR codes and labels; only the default fits the smallest QR code
# export LABEL_ID_BASE_URL=https://i.zam.haus/
# last accesses (label scans, web form entries) kept per label ID
# export LABEL_ID_ACCESS_KEEP=5
# name users see for label IDs (pages, admin, printed labels)
# export LABEL_ID_NAME=ZAMid

# Email on exceptions
ADMINS=[["Foo", "foo@example.com"]]

# Local network (members join LOCAL_GROUP_NAME): comma-separated hostnames (A records),
# IP addresses, or CIDR ranges. The former ZAM_LOCAL_* names still work.
# export LOCAL_NETWORK_SOURCES="das.zam.haus,192.0.2.5,198.51.100.0/24"
# export LOCAL_NETWORK_DNS_CACHE_SECONDS=60
# shown next to members' names and in label ID accesses
# export LOCAL_NETWORK_NAME=ZAM
# group of local members; existing databases have ZAM-local
# export LOCAL_GROUP_NAME=ZAM-local

# gunicorn worker processes, and seconds before a request is aborted (nginx.conf waits
# 120 s, so raise proxy_read_timeout there too for more)
# export GUNICORN_WORKERS=3
# export GUNICORN_TIMEOUT=120

#export POSTGRES_HOST=db
#export POSTGRES_PORT=5432
export POSTGRES_DB=django
export POSTGRES_USER=django
export POSTGRES_PASSWORD=postgres  # place random string here

# Label printing (docs/label-printing.md). docker-compose.yml sets the broker for the worker;
# without one, jobs for network printers print right away in the request.
# export CELERY_BROKER_URL=redis://redis:6379/0
# seconds until an unprinted job expires / a job without result fails / an agent counts as offline
# export PRINT_JOB_MAX_AGE=120
# export PRINT_JOB_LEASE=180
# export PRINT_AGENT_OFFLINE_AFTER=30
# export PRINT_MAX_COPIES=20

export OIDC_RP_CLIENT_ID=
export OIDC_RP_CLIENT_SECRET=
