#: label_printing/models.py:232 label_printing/models.py:304
#: label_printing/models.py:492
msgid "name"
msgstr "Name"

#: label_printing/models.py:30
msgid "agent ID"
msgstr "Agenten-ID"

#: label_printing/models.py:31
msgid "Reported by an agent that registered itself."
msgstr "Von einem Agenten gemeldet, der sich selbst angemeldet hat."

#: label_printing/models.py:32 label_printing/models.py:121
msgid "active"
msgstr "aktiv"

#: label_printing/models.py:33
msgid ""
"Only active agents get jobs; agents that register themselves start inactive."
msgstr ""
"Nur freigeschaltete Agenten bekommen Aufträge; Agenten, die sich selbst "
"anmelden, sind zunächst nicht freigeschaltet."

#: label_printing/models.py:35
msgid "host name"
msgstr "Rechnername"

#: label_printing/models.py:36
msgid "address"
msgstr "Adresse"

#: label_printing/models.py:37
msgid "registered at"
msgstr "angemeldet am"

#: label_printing/models.py:38
msgid "last seen"
msgstr "zuletzt gesehen"

#: label_printing/models.py:39
