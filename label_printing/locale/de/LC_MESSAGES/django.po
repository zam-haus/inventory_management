#: design/__init__.py:24 design/layout.py:452
#, python-format
msgid "There is no label image “%s”."
msgstr "Es gibt kein Etikettenbild „%s“."

#: design/language.py:134
msgid "A quote is not closed."
msgstr "Ein Anführungszeichen ist nicht geschlossen."

#: design/language.py:134
#, python-format
msgid "Unexpected “%s”."
msgstr "Unerwartetes „%s“."

#: design/language.py:150
#, python-format
msgid "“%s” is not a length in mm."
msgstr "„%s“ ist keine Länge in mm."

#: design/language.py:157
#, python-format
msgid "“%s” needs a value."
msgstr "„%s“ braucht einen Wert."

#: design/language.py:162
#, python-format
msgid "“%(name)s” is one of %(values)s, not “%(value)s”."
msgstr "„%(name)s“ ist eins von %(values)s, nicht „%(value)s“."

#: design/language.py:167
#, python-format
msgid "“%(name)s” needs %(count)d lengths."
msgstr "„%(name)s“ braucht %(count)d Längen."

#: design/language.py:174
#, python-format
msgid ""
"“%(name)s” takes 1, 2 or 4 lengths in mm: all sides; top and bottom, left "
"and right; top, right, bottom, left."
msgstr ""
"„%(name)s“ nimmt 1, 2 oder 4 Längen in mm: alle Seiten; oben und unten, "
"links und rechts; oben, rechts, unten, links."

#: design/language.py:184
#, python-format
msgid "“%(name)s” needs a whole number, not “%(value)s”."
msgstr "„%(name)s“ braucht eine ganze Zahl, nicht „%(value)s“."

#: design/language.py:191
#, python-format
msgid ""
"“%(name)s” is a length in mm, a percentage, fill or auto, not “%(value)s”."
msgstr ""
"„%(name)s“ ist eine Länge in mm, ein Prozentwert, fill oder auto, nicht "
"„%(value)s“."

#: design/language.py:215 design/language.py:227
#, python-format
msgid " Did you mean “%s”?"
msgstr " Meintest du „%s“?"

#: design/language.py:216
#, python-format
msgid "“%(word)s” is not an option of %(kind)s."
msgstr "„%(word)s“ ist keine Option von %(kind)s."

#: design/language.py:228
#, python-format
msgid "“%s” is not an element."
msgstr "„%s“ ist kein Element."

#: design/language.py:229
#, python-format
msgid "Elements: %s."
msgstr "Elemente: %s."

#: design/language.py:235
#, python-format
msgid "%s needs the variable it lists first, e.g. {{ contents }}."
msgstr ""
"%s braucht zuerst die Variable, die es auflistet, z. B. {{ contents }}."

#: design/language.py:237
#, python-format
msgid "%s needs its content first: text in quotes or a {{ variable }}."
msgstr ""
"%s braucht zuerst seinen Inhalt: Text in Anführungszeichen oder eine "
"{{ variable }}."

#: design/language.py:238
msgid "image needs the name of a label image first."
msgstr "image braucht zuerst den Namen eines Etikettenbilds."

#: design/language.py:260 design/language.py:297 design/language.py:315
msgid ""
"Start with the size: “label 105 x 52” (width × height in mm) or “label "
"height 12” (as long as the content)."
msgstr ""
"Fang mit der Größe an: „label 105 x 52“ (Breite × Höhe in mm) oder „label "
"height 12“ (so lang wie der Inhalt)."

#: design/language.py:271
msgid "Only labels of a fixed size turn by 90°."
msgstr "Nur Etiketten fester Größe lassen sich um 90° drehen."

#: design/language.py:294
msgid "The label's size is given once, in the first line."
msgstr "Die Größe des Etiketts steht einmal, in der ersten Zeile."

#: design/language.py:307
msgid "Only row and column hold indented elements."
msgstr "Nur row und column enthalten eingerückte Elemente."

#: design/layout.py:90
#, python-format
msgid "There is no “%s”, at least not for this record."
msgstr "Es gibt kein „%s“, zumindest nicht bei diesem Datensatz."

#: design/layout.py:208
msgid "There is no room left for this text."
msgstr "Für diesen Text ist kein Platz mehr."

#: design/layout.py:237
#, python-format
msgid "“%s” is not a list."
msgstr "„%s“ ist keine Liste."

#: design/layout.py:337
msgid "There is no room left for this list."
msgstr "Für diese Liste ist kein Platz mehr."

#: design/layout.py:351
#, python-format
msgid "A Code 128 barcode takes letters, digits and signs, not “%s”."
msgstr ""
"Ein Code-128-Strichcode nimmt Buchstaben, Ziffern und Zeichen, nicht „%s“."

#: design/layout.py:387
#, python-format
msgid "The barcode does not fit: it needs %(mm).1f mm at least."
msgstr "Der Strichcode passt nicht: Er braucht mindestens %(mm).1f mm."

#: design/layout.py:441
#, python-format
msgid "The QR code does not fit: it needs %(mm).1f mm at least."
msgstr "Der QR-Code passt nicht: Er braucht mindestens %(mm).1f mm."

#: design/layout.py:693
#, python-format
msgid "The elements are %(mm).1f mm too long for this %(kind)s."
msgstr "Die Elemente sind %(mm).1f mm zu lang für diese(s) %(kind)s."

#: design/layout.py:800
#, python-format
msgid "The list does not fit on %d labels."
msgstr "Die Liste passt nicht auf %d Etiketten."

#: design/texts.py:52
msgid "Write the condition alone, without {% if %}."
msgstr "Schreib die Bedingung allein, ohne {% if %}."

#: design/variables.py:29
msgid "the location, with all its fields and properties, e.g.:"
msgstr "der Ort, mit all seinen Feldern und Eigenschaften, z. B.:"

#: design/variables.py:30
msgid "what it is called first: its purpose, else its name"
msgstr "wie er zuerst heißt: sein Zweck, sonst sein Name"

#: design/variables.py:31
msgid "its code, e.g. WH-1.R303.a"
msgstr "seine Kennung, z. B. WH-1.R303.a"

#: design/variables.py:32 design/variables.py:52
msgid "its name"
msgstr "sein Name"

#: design/variables.py:33
msgid "where it is: the full path with codes"
msgstr "wo er ist: der ganze Pfad mit Kennungen"

#: design/variables.py:34
msgid ""
"the short names from the top-level location down, e.g. HH-1.SK.K0520 (not on "
"labels: use the code)"
msgstr ""
"die Kurznamen von oben nach unten, z. B. HH-1.SK.K0520 (nicht auf Etiketten: "
"dort den Code)"

#: design/variables.py:36
msgid "its purpose"
msgstr "sein Zweck"

#: design/variables.py:37
msgid "the name of the location it is in"
msgstr "der Name des Orts, in dem er ist"

#: design/variables.py:38
msgid ""
"for QR codes: the code via the label host, HTTPS://I.ZAM.HAUS/WH-1.R303.A"
msgstr ""
"für QR-Codes: die Kennung über den Label-Host, HTTPS://I.ZAM.HAUS/WH-1.R303.A"

#: design/variables.py:39
msgid ""
"for list: what is right at the location: the locations in it with their "
"code, its items with their amount and its unique items with their label ID "
"and whose they are, if not the ZAM's"
msgstr ""
"für list: was direkt an dem Ort ist: die Orte darin mit ihrer Kennung, seine "
"Artikel mit ihrer Menge und seine Einzelstücke mit ihrer Label-ID und wem "
"sie gehören, wenn nicht dem ZAM"

#: design/variables.py:42
msgid ""
"the teams responsible for it (also from a location above it), e.g. "
"Holzwerkstatt"
msgstr ""
"die zuständigen Teams (auch von einem Ort darüber), z. B. Holzwerkstatt"

#: design/variables.py:43
msgid ""
"whose what is at it is, if it is all one owner's other than the ZAM: the "
"first name; empty for the ZAM's"
msgstr ""
"wem das dort gehört, wenn alles demselben gehört und nicht dem ZAM: der "
"Vorname; leer für das ZAM"

#: design/variables.py:45
msgid ""
"whether anything right at it has an owner: items or unique items (not just "
"locations in it)"
msgstr ""
"ob direkt dort etwas mit Eigentümer ist: Artikel oder Einzelstücke (nicht "
"nur Orte darin)"

#: design/variables.py:47
msgid ""
"whether what is at it belongs to different owners (then contents marks whose "
"each unique item is, if not the ZAM's)"
msgstr ""
"ob das dort verschiedenen gehört (dann vermerkt contents bei jedem "
"Einzelstück, wem es gehört, wenn nicht dem ZAM)"

#: design/variables.py:51
msgid "the item, with all its fields and properties, e.g.:"
msgstr "die Sache, mit all ihren Feldern und Eigenschaften, z. B.:"

#: design/variables.py:53
msgid "its price for items for sale, e.g. 0,15; else empty"
msgstr "sein Preis bei Verkaufsartikeln, z. B. 0,15; sonst leer"

#: design/variables.py:54
msgid "its unit, e.g. Stk"
msgstr "seine Einheit, z. B. Stk"

#: design/variables.py:55
msgid ""
"the code of the location it is stored at (the first one); location is the "
"location, if there is one"
msgstr ""
"die Kennung des Orts, an dem er lagert (des ersten); location ist der Ort, "
"wenn es einen gibt"

#: design/variables.py:57 design/variables.py:68
msgid "its label ID as printed, e.g. K7R-4XD"
msgstr "seine Label-ID wie gedruckt, z. B. K7R-4XD"

#: design/variables.py:58
msgid ""
"for QR codes: the item's label ID and the location's code (…/K7R4XD/"
"WH-1.R303.A), leading to the item there"
msgstr ""
"für QR-Codes: die Label-ID des Artikels und die Kennung des Standorts (…/"
"K7R4XD/WH-1.R303.A); führt zum Artikel dort"

#: design/variables.py:62
msgid "the unique item, with all its fields and properties, e.g.:"
msgstr "das Einzelobjekt mit allen Feldern und Eigenschaften, z. B.:"

#: design/variables.py:63
msgid "its owner's first name, if it is not the ZAM's"
msgstr "der Vorname seines Eigentümers, wenn es nicht dem ZAM gehört"

#: design/variables.py:64
msgid "whether it has an owner other than the ZAM (for rules)"
msgstr "ob es einen anderen Eigentümer als das ZAM hat (für Regeln)"

#: design/variables.py:65
msgid "what it is: the item's name"
msgstr "was es ist: der Name der Sache"

#: design/variables.py:66
msgid "its own name, if it has one, to tell it apart"
msgstr "sein eigener Name, falls es einen hat, zur Unterscheidung"

#: design/variables.py:67
msgid "the code of the location it is at"
msgstr "die Kennung des Standorts, an dem es ist"

#: design/variables.py:69 design/variables.py:75
msgid "its first part, e.g. K7R"
msgstr "ihr erster Teil, z. B. K7R"

#: design/variables.py:70 design/variables.py:76
msgid "its second part, e.g. 4XD"
msgstr "ihr zweiter Teil, z. B. 4XD"

#: design/variables.py:71 design/variables.py:78
msgid "for QR codes: the label ID via the label host"
msgstr "für QR-Codes: die Label-ID über den Label-Host"

#: design/variables.py:74
msgid "the label ID as printed, e.g. K7R-4XD"
msgstr "die Label-ID wie gedruckt, z. B. K7R-4XD"

#: design/variables.py:77
msgid "what it belongs to"
msgstr "wozu sie gehört"

#: design/variables.py:81
msgid "what label IDs are called, e.g. ZAMid"
msgstr "wie Label-IDs heißen, z. B. ZAMid"

#: design/variables.py:82
msgid "the number of the label, if a list goes on on further labels (else 1)"
msgstr ""
"die Nummer des Etiketts, wenn eine Liste auf weiteren Etiketten weitergeht "
"(sonst 1)"

#: design/variables.py:83
msgid "how many labels it takes (else 1)"
msgstr "wie viele Etiketten es braucht (sonst 1)"

#: design/variables.py:110
#, python-format
msgid "not the ZAM's: %(name)s"
msgstr "Fremdeigentum: %(name)s"

#: design/variables.py:110 design/variables.py:137
msgid "not the ZAM's"
msgstr "Fremdeigentum"

