#, python-format
msgid "Unexpected “%s”."
msgstr "Unerwartetes „%s“."

#: label_printing/design/language.py:146
#, python-format
msgid "“%s” is not a length in mm."
msgstr "„%s“ ist keine Länge in mm."

#: label_printing/design/language.py:153
#, python-format
msgid "“%s” needs a value."
msgstr "„%s“ braucht einen Wert."

#: label_printing/design/language.py:158
#, python-format
msgid "“%(name)s” is one of %(values)s, not “%(value)s”."
msgstr "„%(name)s“ ist eins von %(values)s, nicht „%(value)s“."

#: label_printing/design/language.py:163
#, python-format
msgid "“%(name)s” needs %(count)d lengths."
msgstr "„%(name)s“ braucht %(count)d Längen."

#: label_printing/design/language.py:170
#, python-format
msgid ""
"“%(name)s” takes 1, 2 or 4 lengths in mm: all sides; top and bottom, left "
"and right; top, right, bottom, left."
msgstr "„%(name)s“ nimmt 1, 2 oder 4 Längen in mm: alle Seiten; oben und unten, links und rechts; oben, rechts, unten, links."

#: label_printing/design/language.py:180
#, python-format
msgid "“%(name)s” needs a whole number, not “%(value)s”."
msgstr "„%(name)s“ braucht eine ganze Zahl, nicht „%(value)s“."

#: label_printing/design/language.py:187
#, python-format
msgid ""
"“%(name)s” is a length in mm, a percentage, fill or auto, not “%(value)s”."
msgstr "„%(name)s“ ist eine Länge in mm, ein Prozentwert, fill oder auto, nicht „%(value)s“."

#: label_printing/design/language.py:211 label_printing/design/language.py:223
#, python-format
msgid " Did you mean “%s”?"
msgstr " Meintest du „%s“?"

