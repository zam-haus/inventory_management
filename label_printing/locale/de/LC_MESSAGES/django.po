#: messages.py:6
msgid "No tape is loaded."
msgstr "Es ist kein Band eingelegt."

#: messages.py:7
msgid "The tape is used up."
msgstr "Das Band ist aufgebraucht."

#: messages.py:8
msgid "The cutter is jammed."
msgstr "Das Schneidmesser klemmt."

#: messages.py:9
msgid "The batteries are weak."
msgstr "Die Akkus sind schwach."

#: messages.py:10
msgid "The wrong power adapter is connected."
msgstr "Das falsche Netzteil ist angeschlossen."

#: messages.py:11
msgid "The loaded tape does not fit this job."
msgstr "Das eingelegte Band passt nicht zu diesem Auftrag."

#: messages.py:12
msgid "The printer reports a communication error."
msgstr "Der Drucker meldet einen Übertragungsfehler."

#: messages.py:13
msgid "The cover is open."
msgstr "Die Abdeckung ist offen."

#: messages.py:14
msgid "The printer is overheated; wait a moment."
msgstr "Der Drucker ist überhitzt; bitte kurz warten."

#: messages.py:15
#, python-format
msgid "%(loaded_mm)s mm tape is loaded, but %(expected_mm)s mm was chosen."
msgstr "Eingelegt ist %(loaded_mm)s-mm-Band, gewählt wurde %(expected_mm)s mm."

#: messages.py:17
msgid "The printer is out of labels."
msgstr "Im Drucker sind keine Etiketten mehr."

#: messages.py:18
msgid "The printer is paused; press its pause button."
msgstr "Der Drucker ist pausiert; drücke seine Pause-Taste."

#: messages.py:19
msgid "The print head is open."
msgstr "Der Druckkopf ist offen."

#: messages.py:20
#, python-format
msgid ""
"The printer measures labels %(measured_mm)s mm long, but labels "
"%(expected_mm)s mm high are set as loaded."
msgstr ""
"Der Drucker misst Etiketten von %(measured_mm)s mm Länge, eingestellt sind "
"aber %(expected_mm)s mm hohe Etiketten."

#: messages.py:22
msgid "The ribbon is used up."
msgstr "Das Farbband ist aufgebraucht."

#: messages.py:23
msgid "The print head is too hot or too cold."
msgstr "Der Druckkopf ist zu heiß oder zu kalt."

#: messages.py:25
msgid "The printer's memory is full."
msgstr "Der Speicher des Druckers ist voll."

#: messages.py:26
msgid "The printer reports a system error."
msgstr "Der Drucker meldet einen Systemfehler."

#: messages.py:27
msgid "The printer reports an error."
msgstr "Der Drucker meldet einen Fehler."

#: messages.py:28
msgid "The printer cannot be reached."
msgstr "Der Drucker ist nicht erreichbar."

#: messages.py:29
msgid "The printer does not answer."
msgstr "Der Drucker antwortet nicht."

#: messages.py:30
msgid "Sending to the printer failed."
msgstr "Senden an den Drucker ist fehlgeschlagen."

#: messages.py:31
msgid "The connection to the printer broke off."
msgstr "Die Verbindung zum Drucker ist abgebrochen."

#: messages.py:32
msgid "The printer took the job but did not confirm it was printed."
msgstr ""
"Der Drucker hat den Auftrag angenommen, aber nicht bestätigt, dass er "
"gedruckt wurde."

#: messages.py:34
msgid "Nobody picked up the job in time, so it was not printed."
msgstr "Der Auftrag wurde nicht rechtzeitig abgeholt und daher nicht gedruckt."

#: messages.py:35
msgid "The print worker or agent did not report back."
msgstr "Der Druckdienst oder Druckagent hat sich nicht zurückgemeldet."

#: messages.py:36
msgid "The print agent of this printer is offline."
msgstr "Der Druckagent dieses Druckers ist offline."

#: messages.py:37
msgid "The printer is switched off in the admin."
msgstr "Der Drucker ist im Admin deaktiviert."

#: messages.py:38 templates/label_printing/form_attrs.html:17
msgid "No printer could print it in time, so it was not printed."
msgstr ""
"Kein Drucker konnte es rechtzeitig drucken, daher wurde es nicht gedruckt."

#: messages.py:39
msgid "What the label was for no longer exists."
msgstr "Wofür das Etikett war, gibt es nicht mehr."

#: messages.py:40
#, python-format
