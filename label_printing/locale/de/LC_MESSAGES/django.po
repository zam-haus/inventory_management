#: design/__init__.py:23 design/layout.py:256
#, python-format
msgid "There is no label image “%s”."
msgstr "Es gibt kein Etikettenbild „%s“."

#: design/language.py:126
msgid "A quote is not closed."
msgstr "Ein Anführungszeichen ist nicht geschlossen."

#: design/language.py:126
#, python-format
msgid "Unexpected “%s”."
msgstr "Unerwartetes „%s“."

#: design/language.py:142
#, python-format
msgid "“%s” is not a length in mm."
msgstr "„%s“ ist keine Länge in mm."

#: design/language.py:149
#, python-format
msgid "“%s” needs a value."
msgstr "„%s“ braucht einen Wert."

#: design/language.py:154
#, python-format
msgid "“%(name)s” is one of %(values)s, not “%(value)s”."
msgstr "„%(name)s“ ist eins von %(values)s, nicht „%(value)s“."

#: design/language.py:159
#, python-format
msgid "“%(name)s” needs %(count)d lengths."
msgstr "„%(name)s“ braucht %(count)d Längen."

#: design/language.py:166
#, python-format
msgid ""
"“%(name)s” takes 1, 2 or 4 lengths in mm: all sides; top and bottom, left "
"and right; top, right, bottom, left."
msgstr ""
"„%(name)s“ nimmt 1, 2 oder 4 Längen in mm: alle Seiten; oben und unten, "
"links und rechts; oben, rechts, unten, links."

#: design/language.py:176
#, python-format
msgid "“%(name)s” needs a whole number, not “%(value)s”."
msgstr "„%(name)s“ braucht eine ganze Zahl, nicht „%(value)s“."

#: design/language.py:183
#, python-format
msgid ""
"“%(name)s” is a length in mm, a percentage, fill or auto, not “%(value)s”."
msgstr ""
"„%(name)s“ ist eine Länge in mm, ein Prozentwert, fill oder auto, nicht "
"„%(value)s“."

#: design/language.py:207 design/language.py:219
#, python-format
msgid " Did you mean “%s”?"
msgstr " Meintest du „%s“?"

#: design/language.py:208
#, python-format
msgid "“%(word)s” is not an option of %(kind)s."
msgstr "„%(word)s“ ist keine Option von %(kind)s."

#: design/language.py:220
#, python-format
msgid "“%s” is not an element."
msgstr "„%s“ ist kein Element."

#: design/language.py:221
#, python-format
msgid "Elements: %s."
msgstr "Elemente: %s."

#: design/language.py:226
#, python-format
msgid "%s needs its content first: text in quotes or a {{ variable }}."
msgstr ""
"%s braucht zuerst seinen Inhalt: Text in Anführungszeichen oder eine "
"{{ variable }}."

#: design/language.py:227
msgid "image needs the name of a label image first."
msgstr "image braucht zuerst den Namen eines Etikettenbilds."

#: design/language.py:249 design/language.py:281 design/language.py:299
msgid ""
"Start with the size: “label 105 x 52” (width × height in mm) or “label "
"height 12” (as long as the content)."
msgstr ""
"Fang mit der Größe an: „label 105 x 52“ (Breite × Höhe in mm) oder „label "
"height 12“ (so lang wie der Inhalt)."

#: design/language.py:278
msgid "The label's size is given once, in the first line."
msgstr "Die Größe des Etiketts steht einmal, in der ersten Zeile."

#: design/language.py:291
msgid "Only row and column hold indented elements."
msgstr "Nur row und column enthalten eingerückte Elemente."

#: design/layout.py:81
#, python-format
msgid "There is no “%s”, at least not for this record."
msgstr "Es gibt kein „%s“, zumindest nicht bei diesem Datensatz."

#: design/layout.py:191
msgid "There is no room left for this text."
msgstr "Für diesen Text ist kein Platz mehr."

#: design/layout.py:245
#, python-format
msgid "The QR code does not fit: it needs %(mm).1f mm at least."
msgstr "Der QR-Code passt nicht: Er braucht mindestens %(mm).1f mm."

#: design/layout.py:486
#, python-format
msgid "The elements are %(mm).1f mm too long for this %(kind)s."
msgstr "Die Elemente sind %(mm).1f mm zu lang für diese(s) %(kind)s."

#: design/texts.py:52
msgid "Write the condition alone, without {% if %}."
msgstr "Schreib die Bedingung allein, ohne {% if %}."

#: design/variables.py:25
msgid "the location, with all its fields and properties, e.g.:"
msgstr "der Ort, mit all seinen Feldern und Eigenschaften, z. B.:"

#: design/variables.py:26
msgid "its code, e.g. WH-1.R303.a"
msgstr "seine Kennung, z. B. WH-1.R303.a"

#: design/variables.py:27 design/variables.py:36
msgid "its name"
msgstr "sein Name"

#: design/variables.py:28
msgid "where it is: the full path with codes"
msgstr "wo er ist: der ganze Pfad mit Kennungen"

#: design/variables.py:29
msgid "the code within its area, e.g. R303.a"
msgstr "die Kennung innerhalb seines Bereichs, z. B. R303.a"

#: design/variables.py:30
msgid "its purpose"
msgstr "sein Zweck"

#: design/variables.py:31
msgid "the name of the location it is in"
msgstr "der Name des Orts, in dem er ist"

#: design/variables.py:32
msgid ""
"for QR codes: the code via the label host, HTTPS://I.ZAM.HAUS/WH-1.R303.A"
msgstr ""
"für QR-Codes: die Kennung über den Label-Host, HTTPS://I.ZAM.HAUS/WH-1.R303.A"

#: design/variables.py:35
msgid "the item, with all its fields and properties, e.g.:"
msgstr "der Artikel, mit all seinen Feldern und Eigenschaften, z. B.:"

#: design/variables.py:37
msgid "its price for items for sale, e.g. 0,15; else empty"
msgstr "sein Preis bei Verkaufsartikeln, z. B. 0,15; sonst leer"

#: design/variables.py:38
msgid "its unit, e.g. Stk"
msgstr "seine Einheit, z. B. Stk"

#: design/variables.py:39
msgid ""
"the code of the location it is stored at (the first one); location is the "
"location, if there is one"
msgstr ""
"die Kennung des Orts, an dem er lagert (des ersten); location ist der Ort, "
"wenn es einen gibt"

#: design/variables.py:41 design/variables.py:51
msgid "its label ID as printed, e.g. K7R-4XD"
msgstr "seine Label-ID wie gedruckt, z. B. K7R-4XD"

#: design/variables.py:42
msgid ""
"for QR codes: the item's label ID and the location's code (…/K7R4XD/"
"WH-1.R303.A), leading to the item there"
msgstr ""
"für QR-Codes: die Label-ID des Artikels und die Kennung des Standorts (…/"
"K7R4XD/WH-1.R303.A); führt zum Artikel dort"

#: design/variables.py:46
msgid "the unique item, with all its fields and properties, e.g.:"
msgstr "das Einzelobjekt mit allen Feldern und Eigenschaften, z. B.:"

#: design/variables.py:47
msgid "its owner's first name, if it is not the ZAM's"
msgstr "der Vorname seines Eigentümers, wenn es nicht dem ZAM gehört"

#: design/variables.py:48
msgid "whether it has an owner other than the ZAM (for rules)"
msgstr "ob es einen anderen Eigentümer als das ZAM hat (für Regeln)"

#: design/variables.py:49
msgid "what it is: the item's name"
msgstr "was es ist: der Name der Sache"

#: design/variables.py:50
msgid "the code of the location it is at"
msgstr "die Kennung des Standorts, an dem es ist"

#: design/variables.py:52 design/variables.py:58
msgid "its first part, e.g. K7R"
msgstr "ihr erster Teil, z. B. K7R"

#: design/variables.py:53 design/variables.py:59
msgid "its second part, e.g. 4XD"
msgstr "ihr zweiter Teil, z. B. 4XD"

#: design/variables.py:54 design/variables.py:61
msgid "for QR codes: the label ID via the label host"
msgstr "für QR-Codes: die Label-ID über den Label-Host"

#: design/variables.py:57
msgid "the label ID as printed, e.g. K7R-4XD"
msgstr "die Label-ID wie gedruckt, z. B. K7R-4XD"

#: design/variables.py:60
msgid "what it belongs to"
msgstr "wozu sie gehört"

#: design/variables.py:64
msgid "what label IDs are called, e.g. ZAMid"
msgstr "wie Label-IDs heißen, z. B. ZAMid"

